# Multi-stage Dockerfile for React client using Vite

# Build stage
FROM node:18-alpine AS build
WORKDIR /app
COPY ../client/package*.json ./
RUN npm install
COPY ../client/ ./
RUN npm run build

# Production stage
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
